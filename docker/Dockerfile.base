# Base Docker image for ChronoX Trading Bot
# Provides Python 3.11, system dependencies, and common packages

FROM python:3.11-slim-bookworm

LABEL maintainer="ChronoX Trading Bot"
LABEL description="Base image with Python and system dependencies"

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    wget \
    vim \
    ca-certificates \
    libgomp1 \
    # For numpy/scipy
    libblas-dev \
    liblapack-dev \
    gfortran \
    # For database connectivity
    libpq-dev \
    # For network tools
    netcat-openbsd \
    iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --upgrade pip setuptools wheel

# Install Python packages (common to all services)
COPY requirements/base.txt /tmp/requirements-base.txt
RUN pip install --no-cache-dir -r /tmp/requirements-base.txt

# Create non-root user
RUN groupadd -r chronox && \
    useradd -r -g chronox -u 1000 -m -s /bin/bash chronox

# Create application directories
RUN mkdir -p /app /app/data /app/logs /app/models && \
    chown -R chronox:chronox /app

# Set working directory
WORKDIR /app

# Switch to non-root user
USER chronox

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.exit(0)"

CMD ["/bin/bash"]
