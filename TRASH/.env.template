# ChronoX Environment Configuration
# Copy this file to .env and fill in your actual values

# Polygon.io API Key (Required)
# Get your key from: https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=your_polygon_api_key_here

# TimescaleDB Configuration (Docker container)
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_DB=chronox
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=chronox_db_password

# Alpaca API (Phase 6 - Trading)
# ALPACA_API_KEY=your_alpaca_key_here
# ALPACA_SECRET_KEY=your_alpaca_secret_here
# ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Paper trading
# ALPACA_BASE_URL=https://api.alpaca.markets  # Live trading

# Monitoring (Phase 7)
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# MLFLOW_PORT=5000
