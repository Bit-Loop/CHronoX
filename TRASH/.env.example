# Polygon.io API
POLYGON_API_KEY=YOUR_POLYGON_KEY_HERE

# TimescaleDB Configuration (PostgreSQL with TimescaleDB extension)
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_DB=chronox
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=chronox_db_password

# Alpaca Trading API (for Phase 7)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# MLflow Tracking (for Phase 3)
MLFLOW_TRACKING_URI=http://localhost:5000

# Airflow (for Phase 6)
AIRFLOW_HOME=./pipelines/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__SECRET_KEY=generate-random-key-here

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
