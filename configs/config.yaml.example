# ChronoX Configuration File
# Copy this to config.yaml and customize

# Data Sources
data_sources:
  polygon:
    enabled: true
    plan: "starter"  # starter, developer, advanced
    rate_limit:
      calls_per_second: 5
      burst: 10
  
  alpaca:
    enabled: false
    paper_trading: true

# Database Configuration
database:
  influxdb:
    url: "http://localhost:8086"
    org: "chronox"
    buckets:
      market_data:
        name: "market_data_5y"
        retention: "1825d"  # 5 years
      indicators:
        name: "indicators_1y"
        retention: "365d"
      corporate_actions:
        name: "corporate_actions"
        retention: "0s"  # infinite
      reference:
        name: "reference_data"
        retention: "0s"
      news:
        name: "news_6mo"
        retention: "180d"
      snapshots:
        name: "snapshots_30d"
        retention: "30d"

# Backfill Configuration
backfill:
  years_back: 5
  chunk_days: 7  # For minute data
  max_workers: 4
  batch_size: 5000
  retry_attempts: 3
  
  priorities:
    - reference_data
    - corporate_actions
    - daily_bars
    - minute_bars
    - news

# Trading Configuration
trading:
  mode: "paper"  # paper, live
  universe:
    market: "stocks"
    min_market_cap: 10000000000  # $10B
    min_volume: 1000000  # Daily volume
    max_tickers: 50
  
  risk_limits:
    max_position_size: 0.05  # 5% of portfolio
    max_leverage: 2.0
    max_drawdown: 0.20  # 20%
    stop_loss: 0.02  # 2%
    take_profit: 0.05  # 5%

# ML Configuration
ml:
  models:
    stockformer:
      enabled: true
      d_model: 512
      n_heads: 8
      n_layers: 6
      dropout: 0.1
    
    finbert:
      enabled: true
      model_name: "ProsusAI/finbert"
      max_length: 512
    
    rl_agent:
      algorithm: "PPO"  # PPO, SAC
      learning_rate: 0.0003
      gamma: 0.99
      episodes: 10000

  training:
    validation_split: 0.2
    test_split: 0.1
    epochs: 100
    batch_size: 32
    early_stopping_patience: 10

# Monitoring Configuration
monitoring:
  prometheus:
    enabled: true
    port: 9090
  
  grafana:
    enabled: true
    port: 3000
  
  alerts:
    email: []
    slack_webhook: ""
  
  metrics:
    - sharpe_ratio
    - max_drawdown
    - win_rate
    - profit_factor
    - api_latency
    - model_accuracy

# Logging Configuration
logging:
  level: "INFO"  # DEBUG, INFO, WARNING, ERROR
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  handlers:
    - console
    - file
  
  files:
    application: "./logs/chronox.log"
    backfill: "./logs/backfill.log"
    trading: "./logs/trading.log"
    errors: "./logs/errors.log"

# Feature Engineering
features:
  technical_indicators:
    - SMA_20
    - SMA_50
    - SMA_200
    - EMA_12
    - EMA_26
    - RSI_14
    - MACD
    - BBands
    - ATR
    - ADX
  
  timeframes:
    - 1min
    - 5min
    - 15min
    - 1hour
    - 1day
  
  sentiment:
    - news_sentiment
    - social_sentiment
    - analyst_ratings

# Backtesting Configuration
backtesting:
  engine: "backtrader"
  initial_capital: 100000
  commission: 0.001  # 0.1%
  slippage: 0.0005  # 0.05%
  
  metrics:
    - total_return
    - sharpe_ratio
    - sortino_ratio
    - max_drawdown
    - win_rate
    - profit_factor
    - calmar_ratio

# Airflow Configuration
orchestration:
  airflow:
    enabled: false
    dag_folder: "./pipelines/airflow_dags"
    schedule_interval: "@daily"
  
  tasks:
    data_ingestion:
      schedule: "*/15 * * * *"  # Every 15 minutes
    
    model_training:
      schedule: "0 2 * * 0"  # Weekly at 2 AM
    
    backtesting:
      schedule: "0 3 * * 0"  # Weekly at 3 AM
    
    monitoring:
      schedule: "*/5 * * * *"  # Every 5 minutes
