# =============================================================================
# ChronoX Finance + Trading Suite — Environment Configuration Template
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# =============================================================================

# --- ChronoX Intelligence Mode & AI Provider ---
# Intelligence Mode:
#   deterministic_only -> Pure optimal quant math (cashflow runway, volatility buffer, marginal-ROI allocator), ZERO external API calls
#   hybrid             -> Optimal quant math + verified AI synthesis (default)
#   ai_standalone      -> Direct AI advisor with PII-redacted live context & RSD-safe tone filtering
CHRONOX_INTELLIGENCE_MODE=hybrid
# Active Provider: auto (prefers OpenCode Go, falls back to Gemini) | opencode_go | gemini
CHRONOX_AI_PROVIDER=auto

# --- OpenCode Go Subscription (Primary AI Provider) ---
# Generate your key in the OpenCode Console: https://opencode.ai
OPENCODE_GO_API_KEY=
# Fallback standard key (used automatically if OPENCODE_GO_API_KEY is unset):
# OPENCODE_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# Any model from your OpenCode Go subscription (use GET /api/ai/models?provider=opencode_go in the UI to pick):
# Examples: glm-5.3-flash, glm-5.3, kimi-k2.6, kimi-k3, minimax-m2.7, qwen3.6-plus, deepseek-v4.1-flash
OPENCODE_GO_MODEL=glm-5.3-flash
OPENCODE_GO_MAX_DAILY_REQUESTS=60

# --- Google Gemini API (Optional AI Provider alongside OpenCode Go) ---
# Generate a key in Google AI Studio: https://aistudio.google.com/apikey
# Always sent via `x-goog-api-key` header (never in URL query params) and never exported in backups.
GEMINI_API_KEY=
# Fallback alias (used automatically if GEMINI_API_KEY is unset):
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- ChronoX Finance (ADHD Self-Updating Auto-Budgeting App) ---
CHRONOX_FINANCE_HOST=127.0.0.1
CHRONOX_FINANCE_PORT=8742
CHRONOX_FINANCE_DB_PATH=.chronox/finance.sqlite3
CHRONOX_FINANCE_SECRET_KEY=
CHRONOX_FINANCE_CURRENCY=USD

# --- ChronoX Market Data & Trading Core (Optional) ---
POLYGON_API_KEY=
POLYGON_S3_ACCESS_KEY=
POLYGON_S3_SECRET_KEY=

TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_DB=chronox
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Docker Monitoring / Orchestration (Optional) ---
GRAFANA_PASSWORD=
AIRFLOW_SECRET_KEY=
